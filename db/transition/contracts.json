  "discrepancies": [
    {
      "id": "AUTH_IDENTITY",
      "gate": "07",
      "rule": "Preserve UUID; auth.users FK and sessions are not portable. Better Auth bridge/reset required."
    },
    {
      "id": "OBJECT_BYTES",
      "gate": "08",
      "rule": "Preserve locator/version; verify actual copied bytes/hash. Metadata-only fixtures do not prove object migration."
    },
    {
      "id": "HISTORICAL_TIMESTAMPS",
      "gate": "06H",
      "rule": "Lifecycle triggers overwrite updated_at with server now(); do not claim historical timestamp equivalence until an audited import path is implemented."
    },
    {
      "id": "EXPLICIT_CONFIRMATION",
      "gate": "10/06G",
      "rule": "Legacy APPROVED_RESUME/VERIFIED is not user confirmation; preserve historical snapshots and require reconfirmation for new usage."
    },
    {
      "id": "STRICT_OWNERSHIP",
      "gate": "06H",
      "rule": "Reject cross-owner or cross-candidate legacy rows; strengthened composite FKs are mandatory, never silently reassign."
    },
    {
      "id": "IMMUTABLE_SNAPSHOTS",
      "gate": "06H",
      "rule": "Resume/extraction/evidence snapshots and deleted rows cannot be overwritten or resurrected. Report conflicts."
    },
    {
      "id": "ARCHIVED_RENDER",
      "gate": "06H",
      "rule": "Import through GENERATING then READY/ARCHIVED; approved source preconditions may fail for historical archived/deleted parents. Do not bypass guards."
    },
    {
      "id": "SOURCE_BOARD_IDENTITY",
      "gate": "14",
      "rule": "Provider-scoped external IDs still collide across boards; reconcile before target activation."
    },
    {
      "id": "AUTOMATION",
      "gate": "20",
      "rule": "Keep historical status/mode values but do not reserve attempts, submit forms or enable automation."
    },
    {
      "id": "SALARY_NULL",
      "gate": "06H",
      "rule": "SPECIFIED salary requires non-null amount/currency in target; reject legacy nulls instead of inventing values."
    },
    {
      "id": "SQL_JSON_NULL",
      "gate": "06H",
      "rule": "Preserve SQL NULL separately from a JSON null literal. Fixture null means SQL NULL; full-row digests carry SQL-null column flags. A real export needs the same sideband metadata."
    }
  ],
