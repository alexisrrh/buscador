# Copiá este archivo a .env (cp .env.example .env) y completá los valores reales.
# El .env NUNCA se sube a git (ver .gitignore).

# --- Web Phase 3: valores públicos del proyecto Supabase ---
# Estas dos variables están diseñadas para el navegador; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secrets que usan los workflows ---

# Phase 5A: autenticacion de aplicacion InfoJobs (solo servidor).
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=
# Activar manualmente para ejecutar el test live opcional.
INFOJOBS_LIVE_TEST=0

# Phase 5B: identifiers publicos opcionales para tests live de ATS.
LEVER_LIVE_SITE=
# GLOBAL o EU.
LEVER_LIVE_INSTANCE=GLOBAL
ASHBY_LIVE_BOARD=

# Registra los dos boards publicos verificados de desarrollo al pulsar Buscar ofertas.
# Usa 0 para desactivar este bootstrap local sin tocar migraciones.
ENABLE_DEVELOPMENT_CAREER_SOURCES=1

# Escrituras de ingestion en Supabase (solo servidor; nunca NEXT_PUBLIC_*).
SUPABASE_SERVICE_ROLE_KEY=

# API key de OpenCode Go (https://opencode.ai/docs/go/), usada por el match
# de IA (CV vs. oferta) y por la generación del CV adaptado.
OPENCODE_API_KEY=

# Bot de Telegram para las notificaciones y el resumen diario.
# Creá uno hablándole a @BotFather en Telegram y pegá el token que te da.
TELEGRAM_BOT_TOKEN=

# Tu chat_id de Telegram (hablale a @userinfobot para conseguirlo).
TELEGRAM_CHAT_ID=

# --- Opcional: exponer n8n con dominio propio detrás de un proxy ---
# N8N_HOST=tu-dominio.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://tu-dominio.com/

# --- Opcional: login básico al editor de n8n (recomendado si el VPS es público) ---
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=
